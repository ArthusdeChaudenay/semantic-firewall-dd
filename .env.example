# ============================================================
# Pare-feu Sémantique DD — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# ── LLM (déjà configuré) ─────────────────────────────────────
# MODEL_NAME=meta/llama-3.1-8b-instruct
# LLM_BASE_URL=https://...
# LLM_API_KEY=...

# ── Notion ───────────────────────────────────────────────────
# Créer une intégration sur https://www.notion.so/my-integrations
# Partager la base de données avec l'intégration
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Airtable ─────────────────────────────────────────────────
# Générer un Personal Access Token sur https://airtable.com/create/tokens
# Scopes requis : data.records:read, data.records:write
AIRTABLE_TOKEN=pat_xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Due Diligence

# ── Microsoft Teams ──────────────────────────────────────────
# Dans Teams : canal → … → Connecteurs → Webhook entrant → Configurer
TEAMS_WEBHOOK_URL=https://xxxx.webhook.office.com/webhookb2/xxxx@xxxx/IncomingWebhook/xxxx/xxxx

# ── SharePoint (Microsoft Graph API) ─────────────────────────
# Enregistrer une application dans Azure AD :
#   Portail Azure → Azure Active Directory → Inscriptions d'applications
#   Permission API : Sites.ReadWrite.All (application, pas déléguée)
SHAREPOINT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHAREPOINT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHAREPOINT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/DueDiligence
SHAREPOINT_FOLDER=Documents partagés/Rapports DD
